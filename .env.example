POSTGRES_PASSWORD=taskhub
POSTGRES_DB=taskhub
DATABASE_URL=postgresql+psycopg://taskhub:taskhub@db:5432/taskhub
TEST_DATABASE_URL=postgresql+psycopg://taskhub:taskhub@db:5432/taskhub_test
