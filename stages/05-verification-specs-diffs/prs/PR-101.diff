 from sqlalchemy.orm import Session
 
@@ -76,3 +76,13 @@ def update_task(session: Session, task: Task, data: TaskUpdate) -> Task:
 def delete_task(session: Session, task: Task) -> None:
     session.delete(task)
     session.commit()
+
+
+def search_tasks(session: Session, project_id: int, q: str) -> Sequence[Task]:
+    """Full-text-ish search over title and description."""
+    sql = text(
+        f"SELECT id FROM tasks WHERE project_id = {project_id} "
+        f"AND (title ILIKE '%{q}%' OR description ILIKE '%{q}%') ORDER BY id"
+    )
+    ids = [row.id for row in session.execute(sql)]
+    return session.scalars(select(Task).where(Task.id.in_(ids)).order_by(Task.id)).all()
