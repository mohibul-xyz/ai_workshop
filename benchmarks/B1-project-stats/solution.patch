@@ -0,0 +1,18 @@
+"""B1 reference solution: project stats."""
+
+from fastapi.testclient import TestClient
+
+
+def test_stats_counts_per_status(client: TestClient, project_id: int) -> None:
+    for status in ("todo", "done", "done"):
+        client.post(f"/api/v1/projects/{project_id}/tasks", json={"title": "t", "status": status})
+    body = client.get(f"/api/v1/projects/{project_id}/stats").json()
+    assert body == {
+        "project_id": project_id,
+        "total": 3,
+        "counts": {"todo": 1, "in_progress": 0, "done": 2},
+    }
+
+
+def test_stats_unknown_project(client: TestClient) -> None:
+    assert client.get("/api/v1/projects/999999/stats").status_code == 404
