@@ -34,3 +34,13 @@ def list_projects(session: Session) -> Sequence[Project]:
 
 def get_project(session: Session, project_id: int) -> Project | None:
     return session.get(Project, project_id)
+
+
+def project_stats(session: Session, project_id: int) -> dict[TaskStatus, int]:
+    """Task count per status; every status is present (0 when none)."""
+    rows = session.execute(
+        select(Task.status, func.count()).where(Task.project_id == project_id).group_by(Task.status)
+    ).all()
+    counts = dict.fromkeys(TaskStatus, 0)
+    counts.update({status: int(n) for status, n in rows})
+    return counts
diff --git a/tests/test_stats.py b/tests/test_stats.py
